@{
    ViewBag.Title = "Reset Password";
    string userName = ViewBag.UserName;
    int userId = ViewBag.UserId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0"><i class="fas fa-key mr-2 text-warning"></i>Reset Password</h4>
    @Html.ActionLink("← Back", "Index", "User", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="card border-0 shadow-sm" style="max-width:450px;">
    <div class="card-header bg-white">
        <span class="text-muted">Resetting password for: </span>
        <strong>@userName</strong>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
        @using (Html.BeginForm("ResetPassword", "User", new { id = userId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" class="form-control" placeholder="Min 6 characters" required />
            </div>
            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter password" required />
            </div>
            <button type="submit" class="btn btn-warning btn-block text-dark font-weight-bold">
                <i class="fas fa-save mr-1"></i>Reset Password
            </button>
        }
    </div>
</div>
