<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - One Fashion</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link href="~/Content/clothshop-styles.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body { background-color: #f4f6f9; }

        .navbar-custom {
            background: linear-gradient(135deg, #1a3a52 0%, #2c5aa0 100%) !important;
            box-shadow: 0 2px 10px rgba(0,0,0,.15);
        }
        .navbar-brand { font-size: 1.6rem; font-weight: 700; color: #D4AF37 !important; }
        .navbar-custom .nav-link { color: #fff !important; font-weight: 500; transition: color .2s; padding: .5rem .75rem; }
        .navbar-custom .nav-link:hover { color: #D4AF37 !important; }
        .user-badge { color: #D4AF37; font-size: .85rem; }

        /* Dropdown fix */
        .navbar-custom .dropdown-menu {
            background: #fff;
            border: none;
            box-shadow: 0 8px 25px rgba(0,0,0,.15);
            border-radius: 8px;
            min-width: 200px;
            margin-top: 8px;
        }
        .navbar-custom .dropdown-item { padding: .6rem 1.2rem; font-size: .9rem; color: #333; }
        .navbar-custom .dropdown-item:hover { background: #f4f6f9; color: #1a3a52; }
        .navbar-custom .dropdown-item.text-danger:hover { background: #fff5f5; }
        .navbar-custom .dropdown-divider { border-color: #eee; }

        .toast-container { position: fixed; top: 70px; right: 20px; z-index: 9999; min-width: 300px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-custom">
        <div class="container-fluid px-3">
            <a class="navbar-brand" href="@Url.Action("Index","Dashboard")">
                <i class="fas fa-crown"></i> One Fashion
            </a>
            <button class="navbar-toggler border-light" type="button" data-toggle="collapse" data-target="#navMain">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Dashboard")">
                            <i class="fas fa-tachometer-alt mr-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","ProductCategory")">
                            <i class="fas fa-tags mr-1"></i>Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Product")">
                            <i class="fas fa-tshirt mr-1"></i>Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Customer")">
                            <i class="fas fa-users mr-1"></i>Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Order")">
                            <i class="fas fa-shopping-bag mr-1"></i>Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Orders","Report")">
                            <i class="fas fa-file-alt mr-1"></i>Reports
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-center">
                    @if (Session["UserName"] != null)
                    {
                        <li class="nav-item mr-2">
                            <span class="user-badge">
                                <i class="fas fa-user-circle mr-1"></i>@Session["UserName"]
                                <span class="badge badge-warning ml-1 text-dark" style="font-size:.65rem;">@Session["UserRole"]</span>
                            </span>
                        </li>
                        <li class="nav-item mr-2">
                            <a class="btn btn-warning btn-sm text-dark font-weight-bold"
                               href="@Url.Action("Create","Order")">
                                <i class="fas fa-plus mr-1"></i>New Order
                            </a>
                        </li>

                        
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" id="settingsDropdown"
                               role="button" data-toggle="dropdown"
                               aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-cog fa-lg"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="settingsDropdown">

                                
                                <a class="dropdown-item" href="@Url.Action("ChangePassword","Account")">
                                    <i class="fas fa-key mr-2 text-warning"></i>Change Password
                                </a>

                                
                                @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
                                {
                                    <a class="dropdown-item" href="@Url.Action("Index","User")">
                                        <i class="fas fa-users-cog mr-2 text-primary"></i>Manage Users
                                    </a>
                                    <a class="dropdown-item" href="@Url.Action("Create","User")">
                                        <i class="fas fa-user-plus mr-2 text-success"></i>Add New User
                                    </a>
                                }

                                <div class="dropdown-divider"></div>

                                
                                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <a class="dropdown-item text-danger" href="#"
                                       onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container">
            <div class="alert alert-success alert-dismissible shadow fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-container">
            <div class="alert alert-danger alert-dismissible shadow fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        </div>
    }

    <div class="container-fluid py-3">
        @RenderBody()
    </div>

    <footer class="text-center text-muted py-3 mt-2" style="font-size:.82rem; border-top:1px solid #dee2e6;">
        &copy; 2025 <strong>One Fashion</strong> &mdash; Cloth Shop Management System
    </footer>

    
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/clothshop-validation.js"></script>

    <script>
        // Auto-dismiss toasts after 4 seconds
        setTimeout(function () {
            $('.toast-container .alert').fadeOut('slow');
        }, 4000);

        // Ensure Bootstrap dropdowns work correctly
        $(document).ready(function () {
            $('.dropdown-toggle').dropdown();
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
