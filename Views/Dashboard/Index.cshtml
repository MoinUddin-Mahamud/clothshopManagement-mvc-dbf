@model MyClothShopManagement.Models.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<div class="row mb-3">
    <div class="col">
        <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-tachometer-alt mr-2 text-primary"></i>Dashboard</h4>
        <small class="text-muted">Welcome back, <strong>@Session["UserName"]</strong> &mdash; @DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #2c5aa0 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small font-weight-bold text-uppercase">Total Products</div>
                    <div class="h3 font-weight-bold text-dark mb-0">@Model.TotalProducts</div>
                </div>
                <div style="background:#e8f0fe; border-radius:50%; width:52px; height:52px; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-tshirt fa-lg text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #28a745 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small font-weight-bold text-uppercase">Total Customers</div>
                    <div class="h3 font-weight-bold text-dark mb-0">@Model.TotalCustomers</div>
                </div>
                <div style="background:#d4edda; border-radius:50%; width:52px; height:52px; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-users fa-lg text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #fd7e14 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small font-weight-bold text-uppercase">Today's Orders</div>
                    <div class="h3 font-weight-bold text-dark mb-0">@Model.TodayOrders</div>
                    <small class="text-success">@Model.TodaySales.ToString("N0") today</small>
                </div>
                <div style="background:#fff3cd; border-radius:50%; width:52px; height:52px; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-shopping-bag fa-lg text-warning"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6f42c1 !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small font-weight-bold text-uppercase">Total Revenue</div>
                    <div class="h3 font-weight-bold text-dark mb-0">@Model.TotalRevenue.ToString("N0")</div>
                    <small class="text-muted">@Model.TotalOrders orders</small>
                </div>
                <div style="background:#f0ebff; border-radius:50%; width:52px; height:52px; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-chart-line fa-lg text-purple" style="color:#6f42c1;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold"><i class="fas fa-chart-bar mr-2 text-primary"></i>Monthly Sales (Last 6 Months)</h6>
            </div>
            <div class="card-body">
                <canvas id="salesChart" height="100"></canvas>
            </div>
        </div>
    </div>

    
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 font-weight-bold text-danger"><i class="fas fa-exclamation-triangle mr-2"></i>Low Stock Alert</h6>
                <span class="badge badge-danger">@Model.LowStockCount items</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.LowStockProducts.Any())
                {
                    <p class="text-muted text-center py-4 mb-0"><i class="fas fa-check-circle text-success mr-1"></i>All products are well stocked!</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="font-weight-bold small">@p.ProductName</div>
                                    <small class="text-muted">@p.CategoryName</small>
                                </div>
                                <span class="badge @(p.AvailableQuantity == 0 ? "badge-danger" : "badge-warning text-dark")">
                                    @p.AvailableQuantity left
                                </span>
                            </div>
                        }
                    </div>
                    <div class="px-3 py-2">
                        @Html.ActionLink("View All Products →", "Index", "Product", null, new { @class = "small text-primary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 font-weight-bold"><i class="fas fa-receipt mr-2 text-primary"></i>Recent Orders</h6>
        @Html.ActionLink("View All", "Index", "Order", null, new { @class = "btn btn-sm btn-outline-primary" })
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th><th>Customer</th><th>Date</th><th>Amount</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No orders yet</td></tr>
                    }
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><span class="badge badge-light border">#@o.OrderId</span></td>
                            <td class="font-weight-bold">@o.CustomerName</td>
                            <td class="text-muted small">@o.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="text-success font-weight-bold">@o.TotalAmount.ToString("N0")</td>
                            <td>@Html.ActionLink("View", "Edit", "Order", new { id = o.OrderId }, new { @class = "btn btn-xs btn-outline-secondary btn-sm" })</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script>
    var labels = [@Html.Raw(string.Join(",", Model.MonthlySales.Select(m => "\"" + m.Month + "\"")))];
    var data   = [@Html.Raw(string.Join(",", Model.MonthlySales.Select(m => m.Total)))];

    new Chart(document.getElementById('salesChart').getContext('2d'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Sales ()',
                data: data,
                backgroundColor: 'rgba(44,90,160,0.7)',
                borderColor: '#2c5aa0',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            legend: { display: false },
            scales: {
                yAxes: [{ ticks: { beginAtZero: true, callback: function(v){ return ''+v.toLocaleString(); } } }]
            },
            tooltips: {
                callbacks: {
                    label: function(t){ return ' ' + parseFloat(t.value).toLocaleString(); }
                }
            }
        }
    });
</script>
}
