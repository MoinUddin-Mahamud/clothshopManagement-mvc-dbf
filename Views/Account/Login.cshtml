@model MyClothShopManagement.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - One Fashion</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1a3a52 0%, #2c5aa0 100%);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
        }
        .login-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 2.5rem 2rem;
            width: 100%; max-width: 400px;
        }
        .brand { text-align: center; margin-bottom: 2rem; }
        .brand i { font-size: 2.5rem; color: #D4AF37; }
        .brand h2 { font-weight: 700; color: #1a3a52; margin-top: .5rem; }
        .brand p { color: #888; font-size: 0.9rem; }
        .btn-login {
            background: linear-gradient(135deg, #1a3a52, #2c5aa0);
            color: #fff; border: none; width: 100%;
            padding: .75rem; border-radius: 8px; font-weight: 600; font-size: 1rem;
        }
        .btn-login:hover { opacity: .9; color: #fff; }
        .form-control:focus { border-color: #2c5aa0; box-shadow: 0 0 0 .2rem rgba(44,90,160,.25); }
        .input-group-text { background: #f8f9fa; border-right: 0; }
        .form-control { border-left: 0; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <i class="fas fa-crown"></i>
            <h2>One Fashion</h2>
            <p>Cloth Shop Management System</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                @Html.LabelFor(m => m.UserName)
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-user text-muted"></i></span>
                    </div>
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Enter username" })
                </div>
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                    </div>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password" })
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
            <button type="submit" class="btn btn-login mt-2">
                <i class="fas fa-sign-in-alt mr-2"></i>Sign In
            </button>
        }
    <p class="text-center text-muted small mt-3 mb-0">&copy; 2025 <strong>One Fashion</strong></p>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
