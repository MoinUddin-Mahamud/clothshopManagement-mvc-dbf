@model MyClothShopManagement.Models.ViewModels.CustomerViewModel
@{ ViewBag.Title = "Delete Customer"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0 text-danger"><i class="fas fa-user-times mr-2"></i>Delete Customer</h4>
    @Html.ActionLink("← Cancel", "Index", "Customer", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="card border-danger shadow-sm" style="max-width:480px;">
    <div class="card-body">
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            Are you sure you want to delete <strong>@Model.CustomerName</strong>?
            @if (Model.OrderCount > 0)
            {
                <br /><small>This customer has <strong>@Model.OrderCount orders</strong> and cannot be deleted.</small>
            }
        </div>
        <dl class="row mb-3">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.CustomerName</dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.ContactNumber</dd>
            <dt class="col-sm-4">Orders</dt><dd class="col-sm-8">@Model.OrderCount</dd>
        </dl>
        @if (Model.OrderCount == 0)
        {
            using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CustomerId)
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i>Confirm Delete</button>
                @Html.ActionLink("Cancel", "Index", "Customer", null, new { @class = "btn btn-secondary ml-2" })
            }
        }
        else
        {
            @Html.ActionLink("Back to Customers", "Index", "Customer", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>
