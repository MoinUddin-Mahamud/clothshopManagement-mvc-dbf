@model IEnumerable<MyClothShopManagement.Models.ViewModels.CustomerViewModel>
@{
    ViewBag.Title = "Customers";
    int currentPage = ViewBag.CurrentPage;
    int totalPages  = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0"><i class="fas fa-users mr-2 text-primary"></i>Customers
        <span class="badge badge-secondary ml-1" style="font-size:.7rem;">@ViewBag.TotalCount</span>
    </h4>
    @if (Session["UserRole"]?.ToString() == "Admin")
    {
        @Html.ActionLink("+ Add Customer", "Create", "Customer", null, new { @class = "btn btn-primary" })
    }
</div>

@using (Html.BeginForm("Index", "Customer", FormMethod.Get))
{
    <div class="input-group mb-3" style="max-width:400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or phone..." />
        <div class="input-group-append">
            <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                @Html.ActionLink("✕", "Index", "Customer", null, new { @class = "btn btn-outline-danger" })
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Orders</th>
                        <th>Total Spent</th>
                        <th>Since</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No customers found.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CustomerId</td>
                            <td class="font-weight-bold">@c.CustomerName</td>
                            <td>@c.ContactNumber</td>
                            <td class="text-muted small">@c.ContactAddress</td>
                            <td><span class="badge badge-primary">@c.OrderCount</span></td>
                            <td class="text-success font-weight-bold">@c.TotalSpent.ToString("N0")</td>
                            <td class="text-muted small">@(c.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>
                                @Html.ActionLink("Details", "Details", new { id = c.CustomerId }, new { @class = "btn btn-xs btn-sm btn-outline-info mr-1" })
                                @Html.ActionLink("Edit", "Edit", new { id = c.CustomerId }, new { @class = "btn btn-xs btn-sm btn-outline-warning mr-1" })
                                @if (Session["UserRole"]?.ToString() == "Admin")
                                {
                                    @Html.ActionLink("Delete", "Delete", new { id = c.CustomerId }, new { @class = "btn btn-xs btn-sm btn-outline-danger" })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = ViewBag.Search })">‹ Prev</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = ViewBag.Search })">Next ›</a>
            </li>
        </ul>
    </nav>
}
