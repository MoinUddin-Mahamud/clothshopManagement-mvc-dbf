@model IEnumerable<MyClothShopManagement.Models.ViewModels.SalesMasterViewModel>
@{
    ViewBag.Title = "Orders";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages  = ViewBag.TotalPages  ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0">
        <i class="fas fa-shopping-bag mr-2 text-primary"></i>Orders
        <span class="badge badge-secondary ml-1" style="font-size:.7rem;">@ViewBag.TotalCount</span>
    </h4>
    @Html.ActionLink("+ Place New Order", "Create", null, new { @class = "btn btn-primary" })
</div>

@using (Html.BeginForm("Index", "Order", FormMethod.Get))
{
    <div class="input-group mb-3" style="max-width:400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by customer name..." />
        <div class="input-group-append">
            <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                @Html.ActionLink("✕", "Index", "Order", null, new { @class = "btn btn-outline-danger" })
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Order Date</th>
                        <th class="text-right">Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No orders found.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge badge-light border">#@item.SaleId</span></td>
                            <td class="font-weight-bold">@item.CustomerName</td>
                            <td class="text-muted">@item.Phone</td>
                            <td class="text-muted small">@item.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="text-right text-success font-weight-bold">@item.TotalAmount.ToString("N2")</td>
                            <td>
                                @Html.ActionLink("Edit", "Edit", new { id = item.SaleId }, new { @class = "btn btn-sm btn-outline-warning mr-1" })
                                @Html.ActionLink("Delete", "Delete", new { id = item.SaleId }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = ViewBag.Search })">‹ Prev</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = ViewBag.Search })">Next ›</a>
            </li>
        </ul>
    </nav>
}
