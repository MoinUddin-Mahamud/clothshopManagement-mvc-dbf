@model MyClothShopManagement.Models.ViewModels.OrderReportFilterViewModel
@{
    ViewBag.Title = "Order Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0"><i class="fas fa-file-alt mr-2 text-primary"></i>Order Report</h4>
    @if (Model.Results != null && Model.Results.Any())
    {
        <a href="@Url.Action("ExportCsv", "Report", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), customerName = Model.CustomerName })"
           class="btn btn-success btn-sm">
            <i class="fas fa-file-csv mr-1"></i>Export CSV
        </a>
    }
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white"><h6 class="mb-0 font-weight-bold"><i class="fas fa-filter mr-2"></i>Filters</h6></div>
    <div class="card-body">
        @using (Html.BeginForm("Orders", "Report", FormMethod.Get))
        {
            <div class="row">
                <div class="col-md-3 form-group">
                    @Html.LabelFor(m => m.FromDate)
                    @Html.TextBoxFor(m => m.FromDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-3 form-group">
                    @Html.LabelFor(m => m.ToDate)
                    @Html.TextBoxFor(m => m.ToDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-4 form-group">
                    @Html.LabelFor(m => m.CustomerName)
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "All customers" })
                </div>
                <div class="col-md-2 form-group d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-search mr-1"></i>Search</button>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.Results != null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 font-weight-bold">Results - @Model.Results.Count row(s)</h6>
            <span class="font-weight-bold text-success">Grand Total: @Model.GrandTotal.ToString("N2")</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Product</th>
                            <th class="text-center">Qty</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Results.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No records found for the selected filters.</td></tr>
                        }
                        @foreach (var r in Model.Results)
                        {
                            <tr>
                                <td><span class="badge badge-light border">#@r.OrderId</span></td>
                                <td class="font-weight-bold">@r.CustomerName</td>
                                <td class="text-muted small">@r.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>@r.ProductName</td>
                                <td class="text-center">@r.OrderQuantity</td>
                                <td class="text-right">@r.UnitPrice.ToString("N2")</td>
                                <td class="text-right text-success font-weight-bold">@r.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Results.Any())
                    {
                        <tfoot class="thead-light">
                            <tr>
                                <th colspan="6" class="text-right">Grand Total:</th>
                                <th class="text-right text-success">@Model.GrandTotal.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
}
